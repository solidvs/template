// Data model of this system (ADR-0016). Written for PostgreSQL, the reference engine, with only
// what every supported engine accepts: `pnpm db:derive` writes the SQL Server version and refuses
// anything else. Change it, then `pnpm db:migration <name>` writes one migration per engine.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// A project of this system: the template's example module. Replace it with the system's own.
model Project {
  /// Address in the web app: /projetos/<id>.
  id        String   @id @db.VarChar(60)
  name      String   @db.VarChar(120)
  createdAt DateTime @map("created_at")
  createdBy String   @map("created_by") @db.VarChar(200)

  @@map("project")
}

/// Business audit trail, owned by @solidvs/server (ADR-0016): insert-only, enforced by the
/// database. Keep this model exactly as the platform kit defines it (AUDIT_EVENT_MODEL).
model AuditEvent {
  id          BigInt   @id @default(autoincrement())
  occurredAt  DateTime @map("occurred_at")
  actor       String   @db.VarChar(200)
  action      String   @db.VarChar(100)
  subjectType String   @map("subject_type") @db.VarChar(100)
  subjectId   String?  @map("subject_id") @db.VarChar(200)
  details     String?  @db.Text

  @@index([subjectType, subjectId])
  @@map("audit_event")
}
