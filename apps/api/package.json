{
  "name": "@example/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & CONFIG_FILE=../../config.local.json node --watch --watch-preserve-output dist/main.js",
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && vitest run",
    "test:db": "CONFIG_FILE=${CONFIG_FILE:-../../config.local.json} vitest run --config vitest.db.config.ts",
    "start": "node dist/main.js",
    "db:derive": "solidvs-data derive",
    "db:migration": "solidvs-data migration",
    "db:check": "solidvs-data derive --check && solidvs-data migration --check",
    "db:lab": "solidvs-data lab up --system example --app-config ../../config.local.json --migration-config ../../config.migration.local.json",
    "db:lab:down": "solidvs-data lab down",
    "db:deploy": "CONFIG_FILE=../../config.migration.local.json prisma migrate deploy",
    "db:drift": "CONFIG_FILE=../../config.migration.local.json solidvs-data drift",
    "db:seed": "CONFIG_FILE=../../config.local.json node dist/seed.js"
  },
  "dependencies": {
    "@example/contracts": "workspace:*",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@prisma/client": "7.10.1",
    "@solidvs/server": "0.5.0",
    "express": "5.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.0",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  },
  "files": [
    "dist"
  ]
}
